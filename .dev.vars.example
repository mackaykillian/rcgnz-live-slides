# Copy to .dev.vars and paste your Airtable personal access token.
# Scopes: data.records:read, data.records:write (badges), schema.bases:read — access: the RCGNZ base only.
# Leave empty to run with mock data.
AIRTABLE_TOKEN=

# Passcode for the sidebar's "Admin only" actions (Fetch Bizzabo).
ADMIN_PASSCODE=
# Shared with the airtable-bizzabo-sync worker (its MANUAL_SYNC_SECRET).
BIZZABO_SYNC_SECRET=

# Optional: where the cron's badge renderer loads badge-render.html (defaults to production in wrangler.jsonc).
# PUBLIC_ORIGIN=http://localhost:5179
