{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rcgnz-live-slides",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React app is served as static assets; only /api/* hits the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // One KV namespace holds the synced snapshot JSON and the cached headshot images.
  "kv_namespaces": [{ "binding": "STORE", "id": "97bfe6fc8e814ac9a150abd2c23ef4c3" }],

  // Scheduled Airtable sync. Tighten during the event, e.g. "*/5 * * * *".
  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    "AIRTABLE_BASE_ID": "appFtt4DomwAITJTa",
    "EVENT_NAME": "RCGNZ Summit 2026"
  },

  "observability": { "enabled": true }
  // Secret (not in this file): AIRTABLE_TOKEN
  //   local:      .dev.vars
  //   production: npx wrangler secret put AIRTABLE_TOKEN
}
