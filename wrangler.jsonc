{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rcgnz-live-slides",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React app is served as static assets; only /api/* hits the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // One KV namespace holds the synced snapshot JSON and the cached headshot images.
  "kv_namespaces": [{ "binding": "STORE", "id": "97bfe6fc8e814ac9a150abd2c23ef4c3" }],

  // Scheduled Airtable sync. Tighten during the event, e.g. "*/5 * * * *".
  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    "AIRTABLE_BASE_ID": "appFtt4DomwAITJTa",
    "EVENT_NAME": "RCGNZ Summit 2026",
    // Where the badge renderer's browser loads badge-render.html from on cron runs
    // (admin requests use their own origin). Override in .dev.vars for local dev.
    "PUBLIC_ORIGIN": "https://rcgnz-live-slides.web-5fb.workers.dev"
  },

  // Headless Chrome for rendering badges (worker/badges/render.ts). Runs locally under `npm run dev`.
  "browser": { "binding": "BROWSER" },

  // The Bizzabo → Airtable sync worker (see "Fetch Bizzabo"). Called through a
  // service binding: Cloudflare blocks a Worker from fetching another Worker's
  // workers.dev URL on the same account (error 1042, returned as a 404).
  // Fetch Bizzabo also runs airtable-bizzabo-tickets (Bizzabo → Registrations, for badges).
  "services": [
    { "binding": "BIZZABO_SYNC", "service": "airtable-bizzabo-sync" },
    { "binding": "BIZZABO_TICKETS", "service": "airtable-bizzabo-tickets" }
  ],

  "observability": { "enabled": true }
  // Secrets (not in this file) — local: .dev.vars, production: npx wrangler secret put <NAME>
  //   AIRTABLE_TOKEN       Airtable personal access token
  //   ADMIN_PASSCODE       unlocks "Admin only" actions in the sidebar
  //   BIZZABO_SYNC_SECRET  must equal MANUAL_SYNC_SECRET on airtable-bizzabo-sync and airtable-bizzabo-tickets
}
